    {
      "id": "impl_count_occurrences",
      "text": "number of times value v appears in list xs",
      "node_type": "implementation",
      "confidence": 0.9,
      "importance": 0.5,
      "metadata": {
        "code": "def count_occurrences(xs, v):\n    c = 0\n    for x in xs:\n        if x == v:\n            c += 1\n    return c\n",
        "entry": "count_occurrences",
        "kind": "atom",
        "origin": "seed",
        "concept": "lists",
        "depends": []
