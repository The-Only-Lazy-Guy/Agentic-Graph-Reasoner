    {
      "id": "impl_max_subarray_sum",
      "text": "largest sum of any contiguous subarray (Kadane)",
      "node_type": "implementation",
      "confidence": 0.9,
      "importance": 0.5,
      "metadata": {
        "code": "def max_subarray_sum(xs):\n    best = xs[0]\n    cur = xs[0]\n    for x in xs[1:]:\n        cur = x if cur < 0 else cur + x\n        if cur > best:\n            best = cur\n    return best\n",
        "entry": "max_subarray_sum",
        "kind": "atom",
