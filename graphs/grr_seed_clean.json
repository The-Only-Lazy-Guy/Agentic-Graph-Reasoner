    },
    {
      "id": "impl_most_common",
      "text": "the element that appears most often in xs (first on ties)",
      "node_type": "implementation",
      "confidence": 0.9,
      "importance": 0.5,
      "metadata": {
        "code": "def most_common(xs):\n    best = None\n    best_c = -1\n    for x in xs:\n        c = count_occurrences(xs, x)\n        if c > best_c:\n            best_c = c\n            best = x\n    return best\n",
        "entry": "most_common",
        "kind": "atom",
        "origin": "seed",
        "concept": "lists",
        "depends": [
          "count_occurrences"
        ]
      },
