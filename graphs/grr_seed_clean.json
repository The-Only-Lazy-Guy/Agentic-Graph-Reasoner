    {
      "id": "impl_gcd",
      "text": "greatest common divisor of a and b",
      "node_type": "implementation",
      "confidence": 0.9,
      "importance": 0.5,
      "metadata": {
        "code": "def gcd(a, b):\n    while b:\n        a, b = b, a % b\n    return a\n",
        "entry": "gcd",
        "kind": "atom",
        "origin": "seed",
        "concept": "number_theory",
        "depends": []
      },
      "access_count": 0,
      "context_guard": {}
    },
    {
      "id": "impl_lcm",
      "text": "least common multiple of a and b",
      "node_type": "implementation",
      "confidence": 0.9,
      "importance": 0.5,
      "metadata": {
        "code": "def lcm(a, b):\n    return a * b // gcd(a, b)\n",
        "entry": "lcm",
        "kind": "atom",
        "origin": "seed",
