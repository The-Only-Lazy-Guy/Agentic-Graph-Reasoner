    {
      "id": "impl_is_prime",
      "text": "primality test \u2014 True iff n is a prime number",
      "node_type": "implementation",
      "confidence": 0.9,
      "importance": 0.5,
      "metadata": {
        "code": "def is_prime(n):\n    if n < 2:\n        return False\n    i = 2\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 1\n    return True\n",
        "entry": "is_prime",
        "kind": "atom",
        "origin": "seed",
        "concept": "number_theory",
        "depends": []
