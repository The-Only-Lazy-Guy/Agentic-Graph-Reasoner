    {
      "id": "impl_is_perfect",
      "text": "True iff n equals the sum of its proper divisors (perfect number)",
      "node_type": "implementation",
      "confidence": 0.9,
      "importance": 0.5,
      "metadata": {
        "code": "def is_perfect(n):\n    return n > 0 and sum_divisors(n) - n == n\n",
        "entry": "is_perfect",
        "kind": "atom",
