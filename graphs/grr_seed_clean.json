    {
      "id": "impl_binary_search",
      "text": "index of target t in sorted list xs, or -1 if absent",
      "node_type": "implementation",
      "confidence": 0.9,
      "importance": 0.5,
      "metadata": {
        "code": "def binary_search(xs, t):\n    lo, hi = 0, len(xs) - 1\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if xs[mid] == t:\n            return mid\n        if xs[mid] < t:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    return -1\n",
        "entry": "binary_search",
        "kind": "atom",
        "origin": "seed",
        "concept": "search",
        "depends": []
      },
      "access_count": 0,
      "context_guard": {}
    },
    {
      "id": "impl_merge_sorted",
      "text": "merge two sorted lists a and b into one sorted list",
      "node_type": "implementation",
      "confidence": 0.9,
      "importance": 0.5,
      "metadata": {
        "code": "def merge_sorted(a, b):\n    i = j = 0\n    out = []\n    while i < len(a) and j < len(b):\n        if a[i] <= b[j]:\n            out.append(a[i]); i += 1\n        else:\n            out.append(b[j]); j += 1\n    out.extend(a[i:]); out.extend(b[j:])\n    return out\n",
        "entry": "merge_sorted",
        "kind": "atom",
        "origin": "seed",
        "concept": "search",
