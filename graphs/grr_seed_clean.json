    {
      "id": "impl_divisors",
      "text": "sorted list of all positive divisors of n",
      "node_type": "implementation",
      "confidence": 0.9,
      "importance": 0.5,
      "metadata": {
        "code": "def divisors(n):\n    out = []\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            out.append(i)\n            if i != n // i:\n                out.append(n // i)\n        i += 1\n    return sorted(out)\n",
        "entry": "divisors",
        "kind": "atom",
        "origin": "seed",
        "concept": "number_theory",
        "depends": []
      },
      "access_count": 0,
      "context_guard": {}
    },
    {
      "id": "impl_sum_divisors",
      "text": "sum of all positive divisors of n",
      "node_type": "implementation",
      "confidence": 0.9,
      "importance": 0.5,
      "metadata": {
        "code": "def sum_divisors(n):\n    return sum(divisors(n))\n",
        "entry": "sum_divisors",
        "kind": "atom",
        "origin": "seed",
        "concept": "number_theory",
        "depends": [
          "divisors"
