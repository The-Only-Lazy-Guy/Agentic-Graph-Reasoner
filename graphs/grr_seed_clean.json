    {
      "id": "impl_running_max",
      "text": "prefix maxima \u2014 list whose i-th element is max(xs[:i+1])",
      "node_type": "implementation",
      "confidence": 0.9,
      "importance": 0.5,
      "metadata": {
        "code": "def running_max(xs):\n    out = []\n    m = None\n    for x in xs:\n        m = x if m is None else (x if x > m else m)\n        out.append(m)\n    return out\n",
        "entry": "running_max",
        "kind": "atom",
        "origin": "seed",
