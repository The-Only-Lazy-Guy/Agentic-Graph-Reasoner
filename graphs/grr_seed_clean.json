    {
      "id": "impl_digit_sum",
      "text": "sum of the decimal digits of a non-negative integer n",
      "node_type": "implementation",
      "confidence": 0.9,
      "importance": 0.5,
      "metadata": {
        "code": "def digit_sum(n):\n    s = 0\n    n = abs(n)\n    while n:\n        s += n % 10\n        n //= 10\n    return s\n",
        "entry": "digit_sum",
        "kind": "atom",
        "origin": "seed",
        "concept": "number_theory",
        "depends": []
      },
      "access_count": 0,
      "context_guard": {}
    },
    {
      "id": "impl_reverse_digits",
      "text": "integer formed by reversing the decimal digits of n",
      "node_type": "implementation",
      "confidence": 0.9,
      "importance": 0.5,
      "metadata": {
        "code": "def reverse_digits(n):\n    r = 0\n    n = abs(n)\n    while n:\n        r = r * 10 + n % 10\n        n //= 10\n    return r\n",
        "entry": "reverse_digits",
        "kind": "atom",
        "origin": "seed",
        "concept": "number_theory",
        "depends": []
      },
      "access_count": 0,
      "context_guard": {}
    },
    {
      "id": "impl_is_palindrome_number",
      "text": "True iff the integer n reads the same forwards and backwards",
      "node_type": "implementation",
      "confidence": 0.9,
      "importance": 0.5,
      "metadata": {
        "code": "def is_palindrome_number(n):\n    return n >= 0 and n == reverse_digits(n)\n",
        "entry": "is_palindrome_number",
