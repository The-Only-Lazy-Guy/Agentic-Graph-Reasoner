    {
      "id": "impl_unique",
      "text": "list with duplicates removed, preserving first-seen order",
      "node_type": "implementation",
      "confidence": 0.9,
      "importance": 0.5,
      "metadata": {
        "code": "def unique(xs):\n    seen = set()\n    out = []\n    for x in xs:\n        if x not in seen:\n            seen.add(x)\n            out.append(x)\n    return out\n",
        "entry": "unique",
        "kind": "atom",
        "origin": "seed",
        "concept": "lists",
        "depends": []
      },
      "access_count": 0,
      "context_guard": {}
    },
    {
      "id": "impl_flatten",
      "text": "flatten a list of lists by one level",
      "node_type": "implementation",
      "confidence": 0.9,
      "importance": 0.5,
      "metadata": {
        "code": "def flatten(xss):\n    out = []\n    for xs in xss:\n        for x in xs:\n            out.append(x)\n    return out\n",
        "entry": "flatten",
